<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cargo_website_flash_sale_list" model="ir.ui.view">
        <field name="name">cargo.website.flash.sale.list</field>
        <field name="model">cargo.website.flash.sale</field>
        <field name="arch" type="xml">
            <list string="Flash Sales">
                <field name="sequence" widget="handle"/>
                <field name="title"/>
                <field name="discount_percent"/>
                <field name="store_id"/>
                <field name="valid_from"/>
                <field name="valid_until"/>
                <field name="is_active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_cargo_website_flash_sale_form" model="ir.ui.view">
        <field name="name">cargo.website.flash.sale.form</field>
        <field name="model">cargo.website.flash.sale</field>
        <field name="arch" type="xml">
            <form string="Flash Sale">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Campaign name (internal)"/></h1>
                    </div>
                    <group>
                        <group string="Display">
                            <field name="title"/>
                            <field name="subtitle"/>
                            <field name="image_url"/>
                            <field name="discount_percent"/>
                            <field name="discount_label"/>
                            <field name="coupon_code"/>
                        </group>
                        <group string="Targeting &amp; Schedule">
                            <field name="store_id"/>
                            <field name="sequence"/>
                            <field name="is_active"/>
                            <field name="valid_from"/>
                            <field name="valid_until"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cargo_website_flash_sale" model="ir.actions.act_window">
        <field name="name">Flash Sales</field>
        <field name="res_model">cargo.website.flash.sale</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
