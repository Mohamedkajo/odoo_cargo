<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cargo_website_job_list" model="ir.ui.view">
        <field name="name">cargo.website.job.list</field>
        <field name="model">cargo.website.job</field>
        <field name="arch" type="xml">
            <list string="Job Listings">
                <field name="title"/>
                <field name="department"/>
                <field name="location"/>
                <field name="job_type"/>
                <field name="posted_date"/>
                <field name="is_active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_cargo_website_job_form" model="ir.ui.view">
        <field name="name">cargo.website.job.form</field>
        <field name="model">cargo.website.job</field>
        <field name="arch" type="xml">
            <form string="Job Listing">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="title" placeholder="Job Title"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="department"/>
                            <field name="location"/>
                            <field name="job_type"/>
                            <field name="salary_range"/>
                        </group>
                        <group>
                            <field name="is_active"/>
                            <field name="posted_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" widget="html"/>
                        </page>
                        <page string="Requirements" name="requirements">
                            <field name="requirements" widget="html"/>
                        </page>
                        <page string="Benefits" name="benefits">
                            <field name="benefits" widget="html"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cargo_website_job" model="ir.actions.act_window">
        <field name="name">Job Listings</field>
        <field name="res_model">cargo.website.job</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
