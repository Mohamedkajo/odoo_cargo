<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
    ═══════════════════════════════════════════════════════════════════════
    Cargo Marketplace — Top-level menu
    All child menus from other modules attach to this root.
    ═══════════════════════════════════════════════════════════════════════
    -->
    <menuitem id="cargo_menu_root"
              name="Cargo"
              web_icon="cargo_base,static/description/icon.png"
              sequence="50"
              groups="cargo_base.cargo_group_operations,cargo_base.cargo_group_finance,cargo_base.cargo_group_admin,cargo_base.cargo_group_super_admin"/>

    <!-- ── Administration sub-menu ─────────────────────────────────────── -->
    <menuitem id="cargo_menu_admin"
              name="Administration"
              parent="cargo_menu_root"
              sequence="90"
              groups="cargo_base.cargo_group_admin"/>

    <menuitem id="cargo_menu_audit_log"
              name="Audit Log"
              parent="cargo_menu_admin"
              action="action_cargo_audit_log"
              sequence="10"
              groups="cargo_base.cargo_group_admin"/>

    <menuitem id="cargo_menu_settings"
              name="Settings"
              parent="cargo_menu_admin"
              action="action_cargo_config_settings"
              sequence="99"
              groups="cargo_base.cargo_group_super_admin"/>

</odoo>
