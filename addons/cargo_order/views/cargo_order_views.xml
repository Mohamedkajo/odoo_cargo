<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cargo_order_form" model="ir.ui.view">
        <field name="name">cargo.order.form</field>
        <field name="model">cargo.order</field>
        <field name="arch" type="xml">
            <form string="Order">
                <header>
                    <field name="status" widget="statusbar"
                           statusbar_visible="confirmed,preparing,ready,collecting,delivering,otp_check,delivered"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            class="oe_highlight"
                            attrs="{'invisible': [('status', 'in', ['delivered', 'cancelled'])]}"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="user_id"/>
                            <field name="store_id"/>
                            <field name="payment_method"/>
                        </group>
                        <group>
                            <field name="subtotal"/>
                            <field name="delivery_fee"/>
                            <field name="discount"/>
                            <field name="total"/>
                            <field name="item_count"/>
                        </group>
                    </group>
                    <group string="Delivery">
                        <field name="delivery_address"/>
                        <field name="estimated_time"/>
                        <field name="driver_id"/>
                        <field name="driver_name"/>
                        <field name="driver_phone"/>
                    </group>
                    <notebook>
                        <page string="Items">
                            <field name="line_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="price"/>
                                    <field name="quantity"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_cargo_order_list" model="ir.ui.view">
        <field name="name">cargo.order.list</field>
        <field name="model">cargo.order</field>
        <field name="arch" type="xml">
            <list string="Orders" default_order="id desc">
                <field name="name"/>
                <field name="user_id"/>
                <field name="store_name"/>
                <field name="status"/>
                <field name="total"/>
                <field name="payment_method"/>
                <field name="created_at"/>
            </list>
        </field>
    </record>

    <record id="action_cargo_order" model="ir.actions.act_window">
        <field name="name">Orders</field>
        <field name="res_model">cargo.order</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
