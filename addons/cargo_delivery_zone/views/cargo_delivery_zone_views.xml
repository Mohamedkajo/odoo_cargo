<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cargo_delivery_zone_list" model="ir.ui.view">
        <field name="name">cargo.delivery.zone.list</field>
        <field name="model">cargo.delivery.zone</field>
        <field name="arch" type="xml">
            <list string="Delivery Zones">
                <field name="name"/>
                <field name="city"/>
                <field name="base_delivery_fee"/>
                <field name="min_order_amount"/>
                <field name="max_radius_km"/>
                <field name="is_active"/>
            </list>
        </field>
    </record>
    <record id="action_cargo_delivery_zone" model="ir.actions.act_window">
        <field name="name">Delivery Zones</field>
        <field name="res_model">cargo.delivery.zone</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
