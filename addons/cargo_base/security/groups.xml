<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
        ═══════════════════════════════════════════════════════════
        Cargo Module Category
        ═══════════════════════════════════════════════════════════
        -->
        <record id="module_category_cargo" model="ir.module.category">
            <field name="name">Cargo Marketplace</field>
            <field name="description">
                Security groups for the Cargo multi-vendor marketplace platform.
            </field>
            <field name="sequence">100</field>
        </record>

        <!--
        ═══════════════════════════════════════════════════════════
        Tier 1 — End Users (mutually exclusive mobile roles)
        ═══════════════════════════════════════════════════════════
        -->

        <!-- Customer: browse stores, place orders, manage wallet/coupons -->
        <record id="cargo_group_customer" model="res.groups">
            <field name="name">Customer</field>
            <field name="category_id" ref="module_category_cargo"/>
            <field name="comment">
                Mobile app customers. Can place orders, manage their wallet,
                apply coupons and write reviews.
            </field>
        </record>

        <!-- Vendor: manage their own store, products and view own orders -->
        <record id="cargo_group_vendor" model="res.groups">
            <field name="name">Vendor</field>
            <field name="category_id" ref="module_category_cargo"/>
            <field name="comment">
                Store owners / operators. Restricted to their own store records
                via record rules.
            </field>
        </record>

        <!-- Vendor Manager: vendor + can approve/reject vendor applications -->
        <record id="cargo_group_vendor_manager" model="res.groups">
            <field name="name">Vendor Manager</field>
            <field name="category_id" ref="module_category_cargo"/>
            <field name="implied_ids" eval="[(4, ref('cargo_group_vendor'))]"/>
            <field name="comment">
                Inherits Vendor. Can also approve/reject vendor onboarding,
                manage store categories and promotions.
            </field>
        </record>

        <!-- Driver: view assigned deliveries, update delivery status, confirm OTP -->
        <record id="cargo_group_driver" model="res.groups">
            <field name="name">Driver</field>
            <field name="category_id" ref="module_category_cargo"/>
            <field name="comment">
                Delivery drivers. Restricted to their own assigned orders
                and delivery records via record rules.
            </field>
        </record>

        <!--
        ═══════════════════════════════════════════════════════════
        Tier 2 — Back-Office Staff
        ═══════════════════════════════════════════════════════════
        -->

        <!-- Operations: manage orders, drivers, stores — read-only on financials -->
        <record id="cargo_group_operations" model="res.groups">
            <field name="name">Operations</field>
            <field name="category_id" ref="module_category_cargo"/>
            <field name="comment">
                Operations team. Full access to orders, deliveries and store
                management. Read-only on financial data.
            </field>
        </record>

        <!-- Finance: manage wallets, payouts, commissions, invoices -->
        <record id="cargo_group_finance" model="res.groups">
            <field name="name">Finance</field>
            <field name="category_id" ref="module_category_cargo"/>
            <field name="comment">
                Finance team. Full access to wallet transactions, payout
                requests, commission reports and invoices.
            </field>
        </record>

        <!--
        ═══════════════════════════════════════════════════════════
        Tier 3 — Administrators
        ═══════════════════════════════════════════════════════════
        -->

        <!-- Admin: all operations + finance + user management -->
        <record id="cargo_group_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="module_category_cargo"/>
            <field name="implied_ids" eval="[
                (4, ref('cargo_group_operations')),
                (4, ref('cargo_group_finance')),
            ]"/>
            <field name="comment">
                Platform administrators. Inherits Operations and Finance.
                Can manage all platform users, settings and configurations.
            </field>
        </record>

        <!-- Super Admin: unrestricted platform access + audit log access -->
        <record id="cargo_group_super_admin" model="res.groups">
            <field name="name">Super Administrator</field>
            <field name="category_id" ref="module_category_cargo"/>
            <field name="implied_ids" eval="[(4, ref('cargo_group_admin'))]"/>
            <field name="comment">
                Super administrators. Inherits Administrator.
                Unrestricted access including audit logs, JWT configuration
                and system parameters.
            </field>
        </record>

    </data>
</odoo>
