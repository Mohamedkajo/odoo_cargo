<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Inherit form view to add Cargo tab ───────────────────────────── -->
    <record id="cargo_res_partner_view_form" model="ir.ui.view">
        <field name="name">res.partner.form.cargo</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <!-- Insert Cargo fields as a dedicated notebook page -->
            <notebook position="inside">
                <page string="Cargo" name="cargo_marketplace"
                      attrs="{'invisible': [('cargo_is_cargo_user', '=', False)]}">
                    <group>
                        <group string="Cargo Profile">
                            <field name="cargo_role"/>
                            <field name="cargo_is_cargo_user" invisible="1"/>
                        </group>
                        <group string="Loyalty">
                            <field name="cargo_loyalty_points"/>
                        </group>
                    </group>
                    <group string="Computed">
                        <field name="cargo_full_address" readonly="1"/>
                        <field name="cargo_display_name" readonly="1"/>
                    </group>
                </page>
            </notebook>

            <!-- Add cargo_role to the right status bar for quick visibility -->
            <div name="button_box" position="inside">
                <button type="object" name="action_view_sale_order"
                        class="oe_stat_button" icon="fa-shopping-cart"
                        attrs="{'invisible': [('cargo_role', '!=', 'customer')]}">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Orders</span>
                    </div>
                </button>
            </div>

        </field>
    </record>

    <!-- ── Inherit list view to surface role column ─────────────────────── -->
    <record id="cargo_res_partner_view_list" model="ir.ui.view">
        <field name="name">res.partner.list.cargo</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <field name="country_id" position="after">
                <field name="cargo_role" optional="show"/>
                <field name="cargo_loyalty_points" optional="hide"/>
            </field>
        </field>
    </record>

    <!-- ── Inherit search view to allow filtering by role ───────────────── -->
    <record id="cargo_res_partner_view_search" model="ir.ui.view">
        <field name="name">res.partner.search.cargo</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <filter name="filter_customers" position="after">
                <separator/>
                <filter name="cargo_customer" string="Cargo Customers"
                        domain="[('cargo_role', '=', 'customer')]"/>
                <filter name="cargo_vendor"   string="Cargo Vendors"
                        domain="[('cargo_role', '=', 'vendor')]"/>
                <filter name="cargo_driver"   string="Cargo Drivers"
                        domain="[('cargo_role', '=', 'driver')]"/>
            </filter>
        </field>
    </record>

</odoo>
