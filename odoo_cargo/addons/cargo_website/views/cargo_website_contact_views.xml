<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cargo_website_contact_list" model="ir.ui.view">
        <field name="name">cargo.website.contact.list</field>
        <field name="model">cargo.website.contact</field>
        <field name="arch" type="xml">
            <list string="Contact Submissions" default_order="create_date desc"
                  decoration-info="status == 'new'"
                  decoration-muted="status == 'closed'">
                <field name="create_date" string="Received"/>
                <field name="name"/>
                <field name="email"/>
                <field name="subject"/>
                <field name="status"/>
                <field name="source"/>
            </list>
        </field>
    </record>

    <record id="view_cargo_website_contact_form" model="ir.ui.view">
        <field name="name">cargo.website.contact.form</field>
        <field name="model">cargo.website.contact</field>
        <field name="arch" type="xml">
            <form string="Contact Submission">
                <header>
                    <field name="status" widget="statusbar"
                           statusbar_visible="new,read,replied,closed"/>
                </header>
                <sheet>
                    <group>
                        <group string="Sender">
                            <field name="name"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="subject"/>
                        </group>
                        <group string="Meta">
                            <field name="source"/>
                            <field name="create_date" string="Received At"/>
                            <field name="ip_address"/>
                        </group>
                    </group>
                    <group string="Message">
                        <field name="message" nolabel="1" colspan="2" readonly="1"/>
                    </group>
                    <group string="Internal Notes">
                        <field name="notes" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cargo_website_contact_search" model="ir.ui.view">
        <field name="name">cargo.website.contact.search</field>
        <field name="model">cargo.website.contact</field>
        <field name="arch" type="xml">
            <search string="Contact Submissions">
                <field name="name"/>
                <field name="email"/>
                <filter string="New" name="filter_new"
                        domain="[('status', '=', 'new')]"/>
                <filter string="Read" name="filter_read"
                        domain="[('status', '=', 'read')]"/>
                <filter string="Replied" name="filter_replied"
                        domain="[('status', '=', 'replied')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status"  name="group_status"  context="{'group_by': 'status'}"/>
                    <filter string="Subject" name="group_subject" context="{'group_by': 'subject'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cargo_website_contact" model="ir.actions.act_window">
        <field name="name">Contact Submissions</field>
        <field name="res_model">cargo.website.contact</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_new': 1}</field>
    </record>
</odoo>
