<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cargo_inventory_list" model="ir.ui.view">
        <field name="name">cargo.inventory.list</field>
        <field name="model">cargo.inventory</field>
        <field name="arch" type="xml">
            <list string="Inventory" decoration-danger="is_low_stock == True">
                <field name="store_id"/>
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="reserved_qty"/>
                <field name="available_qty"/>
                <field name="alert_qty"/>
                <field name="is_low_stock" invisible="1"/>
            </list>
        </field>
    </record>
    <record id="action_cargo_inventory" model="ir.actions.act_window">
        <field name="name">Inventory</field>
        <field name="res_model">cargo.inventory</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
