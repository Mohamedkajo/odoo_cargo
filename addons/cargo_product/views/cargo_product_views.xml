<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend the native product.template form with Cargo marketplace fields -->

    <record id="view_product_template_cargo_form" model="ir.ui.view">
        <field name="name">product.template.cargo.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Cargo Marketplace" name="cargo">
                    <group string="Store &amp; Category">
                        <field name="cargo_store_id"/>
                        <field name="cargo_is_available"/>
                        <field name="cargo_is_featured"/>
                        <field name="cargo_is_trending"/>
                        <field name="cargo_image_url"/>
                    </group>
                    <group string="Pricing">
                        <field name="cargo_original_price"/>
                        <field name="cargo_discount_percent"/>
                        <field name="cargo_effective_price"/>
                    </group>
                    <group string="Ratings">
                        <field name="cargo_rating"/>
                        <field name="cargo_review_count"/>
                    </group>
                    <group string="Flash Sale">
                        <field name="cargo_is_flash_sale"/>
                        <field name="cargo_flash_sale_price"
                               invisible="not cargo_is_flash_sale"/>
                        <field name="cargo_flash_sale_end"
                               invisible="not cargo_is_flash_sale"/>
                    </group>
                    <separator string="Add-ons"/>
                    <field name="cargo_addon_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="price"/>
                            <field name="is_required"/>
                        </list>
                    </field>
                    <separator string="Variants"/>
                    <field name="cargo_variant_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="options"/>
                            <field name="price_delta"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Cargo products list view (marketplace products only) -->
    <record id="view_product_template_cargo_list" model="ir.ui.view">
        <field name="name">product.template.cargo.list</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <list string="Marketplace Products">
                <field name="name"/>
                <field name="cargo_store_id"/>
                <field name="categ_id" string="Menu Section"/>
                <field name="list_price" string="Price (EGP)"/>
                <field name="cargo_rating"/>
                <field name="cargo_is_available"/>
                <field name="cargo_is_featured"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_cargo_product" model="ir.actions.act_window">
        <field name="name">Marketplace Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('cargo_store_id', '!=', False)]</field>
        <field name="context">{'search_default_filter_to_sell': 0}</field>
        <field name="view_id" ref="view_product_template_cargo_list"/>
    </record>

</odoo>
