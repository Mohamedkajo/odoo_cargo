<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Inherit form view — add Cargo delivery fields ────────────────── -->
    <record id="cargo_sale_order_view_form" model="ir.ui.view">
        <field name="name">sale.order.form.cargo</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Status bar pill — use XPath to target header's state field precisely -->
            <xpath expr="//header/field[@name='state']" position="before">
                <field name="cargo_status" widget="statusbar"
                       statusbar_visible="confirmed,preparing,ready,collecting,delivering,otp_check,delivered"
                       string="Cargo Status"/>
            </xpath>

            <!-- Cargo delivery group after existing fields -->
            <page name="order_lines" position="after">
                <page string="Cargo Delivery" name="cargo_delivery">
                    <group>
                        <group string="Delivery">
                            <field name="cargo_store_id" readonly="1"
                                   string="Store ID"/>
                            <field name="cargo_driver_id" readonly="1"
                                   string="Driver ID"/>
                            <field name="cargo_delivery_fee" widget="monetary"/>
                            <field name="cargo_estimated_time"
                                   string="Estimated Time (min)"/>
                        </group>
                        <group string="Commission">
                            <field name="cargo_commission_rate"
                                   string="Commission Rate (%)"/>
                            <field name="cargo_commission_amount" readonly="1"
                                   widget="monetary"/>
                            <field name="cargo_vendor_earnings" readonly="1"
                                   widget="monetary"/>
                        </group>
                    </group>
                    <group string="OTP Verification">
                        <field name="cargo_otp_code" readonly="1"/>
                        <field name="cargo_otp_verified" readonly="1"/>
                        <field name="cargo_otp_expires_at" readonly="1"/>
                    </group>
                </page>
            </page>

        </field>
    </record>

    <!-- ── Inherit list view ─────────────────────────────────────────────── -->
    <record id="cargo_sale_order_view_list" model="ir.ui.view">
        <field name="name">sale.order.list.cargo</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="cargo_status" optional="show"
                       decoration-success="cargo_status == 'delivered'"
                       decoration-danger="cargo_status == 'cancelled'"
                       decoration-info="cargo_status in ('collecting','delivering')"
                       decoration-warning="cargo_status in ('confirmed','preparing','ready')"/>
            </field>
        </field>
    </record>

    <!-- ── Search view ───────────────────────────────────────────────────── -->
    <record id="cargo_sale_order_view_search" model="ir.ui.view">
        <field name="name">sale.order.search.cargo</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <filter name="my_sale_orders_filter" position="after">
                <separator/>
                <filter name="cargo_confirmed"  string="Confirmed"
                        domain="[('cargo_status', '=', 'confirmed')]"/>
                <filter name="cargo_preparing"  string="Preparing"
                        domain="[('cargo_status', '=', 'preparing')]"/>
                <filter name="cargo_delivering" string="Delivering"
                        domain="[('cargo_status', '=', 'delivering')]"/>
                <filter name="cargo_delivered"  string="Delivered"
                        domain="[('cargo_status', '=', 'delivered')]"/>
                <filter name="cargo_cancelled"  string="Cancelled"
                        domain="[('cargo_status', '=', 'cancelled')]"/>
            </filter>
        </field>
    </record>

</odoo>
