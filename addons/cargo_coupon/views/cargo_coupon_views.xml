<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cargo_coupon_list" model="ir.ui.view">
        <field name="name">cargo.coupon.list</field>
        <field name="model">cargo.coupon</field>
        <field name="arch" type="xml">
            <list string="Coupons">
                <field name="code"/>
                <field name="coupon_type"/>
                <field name="discount_value"/>
                <field name="min_order_value"/>
                <field name="usage_limit"/>
                <field name="used_count"/>
                <field name="valid_until"/>
                <field name="is_active"/>
            </list>
        </field>
    </record>
    <record id="action_cargo_coupon" model="ir.actions.act_window">
        <field name="name">Coupons</field>
        <field name="res_model">cargo.coupon</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
