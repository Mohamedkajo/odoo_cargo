<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_cargo_wallet_own" model="ir.rule">
        <field name="name">Cargo Wallet: Customer sees own wallet only</field>
        <field name="model_id" ref="model_cargo_wallet"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('cargo_base.cargo_group_customer'))]"/>
    </record>

    <record id="rule_cargo_wallet_transaction_own" model="ir.rule">
        <field name="name">Cargo Wallet Transaction: Customer sees own transactions only</field>
        <field name="model_id" ref="model_cargo_wallet_transaction"/>
        <field name="domain_force">[('wallet_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('cargo_base.cargo_group_customer'))]"/>
    </record>
</odoo>
