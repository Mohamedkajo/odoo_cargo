<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cargo_delivery_list" model="ir.ui.view">
        <field name="name">cargo.delivery.list</field>
        <field name="model">cargo.delivery</field>
        <field name="arch" type="xml">
            <list string="Deliveries">
                <field name="order_id"/>
                <field name="driver_id"/>
                <field name="status"/>
                <field name="assigned_at"/>
                <field name="delivered_at"/>
            </list>
        </field>
    </record>
    <record id="action_cargo_delivery" model="ir.actions.act_window">
        <field name="name">Deliveries</field>
        <field name="res_model">cargo.delivery</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
