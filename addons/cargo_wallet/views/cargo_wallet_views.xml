<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cargo_wallet_form" model="ir.ui.view">
        <field name="name">cargo.wallet.form</field>
        <field name="model">cargo.wallet</field>
        <field name="arch" type="xml">
            <form string="Wallet">
                <sheet>
                    <group>
                        <field name="user_id"/>
                        <field name="balance"/>
                        <field name="currency"/>
                    </group>
                    <notebook>
                        <page string="Transactions">
                            <field name="transaction_ids">
                                <list>
                                    <field name="created_at"/>
                                    <field name="type"/>
                                    <field name="amount"/>
                                    <field name="description"/>
                                    <field name="balance_after"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cargo_wallet_list" model="ir.ui.view">
        <field name="name">cargo.wallet.list</field>
        <field name="model">cargo.wallet</field>
        <field name="arch" type="xml">
            <list string="Wallets">
                <field name="user_id"/>
                <field name="balance"/>
                <field name="currency"/>
            </list>
        </field>
    </record>

    <record id="action_cargo_wallet" model="ir.actions.act_window">
        <field name="name">Wallets</field>
        <field name="res_model">cargo.wallet</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
