<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── cargo.store.category ─────────────────────────────────────────── -->

    <record id="view_cargo_store_category_list" model="ir.ui.view">
        <field name="name">cargo.store.category.list</field>
        <field name="model">cargo.store.category</field>
        <field name="arch" type="xml">
            <list string="Store Categories">
                <field name="sequence" widget="handle"/>
                <field name="icon"/>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_cargo_store_category_form" model="ir.ui.view">
        <field name="name">cargo.store.category.form</field>
        <field name="model">cargo.store.category</field>
        <field name="arch" type="xml">
            <form string="Store Category">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="icon"/>
                        <field name="image"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cargo_store_category" model="ir.actions.act_window">
        <field name="name">Store Categories</field>
        <field name="res_model">cargo.store.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ── cargo.product.category ───────────────────────────────────────── -->

    <record id="view_cargo_product_category_list" model="ir.ui.view">
        <field name="name">cargo.product.category.list</field>
        <field name="model">cargo.product.category</field>
        <field name="arch" type="xml">
            <list string="Product Categories">
                <field name="sequence" widget="handle"/>
                <field name="icon"/>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_cargo_product_category_form" model="ir.ui.view">
        <field name="name">cargo.product.category.form</field>
        <field name="model">cargo.product.category</field>
        <field name="arch" type="xml">
            <form string="Product Category">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="icon"/>
                        <field name="image"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cargo_product_category" model="ir.actions.act_window">
        <field name="name">Product Categories</field>
        <field name="res_model">cargo.product.category</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
