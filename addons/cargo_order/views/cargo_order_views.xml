<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend native sale.order form with Cargo delivery fields -->
    <record id="view_sale_order_cargo_form" model="ir.ui.view">
        <field name="name">sale.order.cargo.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Cargo Delivery" name="cargo_delivery">
                    <group string="Delivery">
                        <field name="cargo_store_id"/>
                        <field name="cargo_status"/>
                        <field name="cargo_delivery_address"/>
                        <field name="cargo_payment_method"/>
                        <field name="cargo_delivery_fee"/>
                        <field name="cargo_discount"/>
                        <field name="cargo_coupon_code"/>
                        <field name="cargo_estimated_time"/>
                    </group>
                    <group string="Driver">
                        <field name="cargo_driver_id"/>
                        <field name="cargo_driver_name" readonly="1"/>
                        <field name="cargo_driver_phone" readonly="1"/>
                        <field name="cargo_driver_rating" readonly="1"/>
                    </group>
                    <group string="OTP Verification">
                        <field name="cargo_otp_code" readonly="1"/>
                        <field name="cargo_otp_verified" readonly="1"/>
                        <field name="cargo_otp_expires_at" readonly="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Cargo orders list (sale.orders that have a cargo_status) -->
    <record id="view_sale_order_cargo_list" model="ir.ui.view">
        <field name="name">sale.order.cargo.list</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <list string="Cargo Orders">
                <field name="name"/>
                <field name="partner_id" string="Customer"/>
                <field name="cargo_store_id" string="Store"/>
                <field name="cargo_status" string="Delivery Status"/>
                <field name="amount_total" string="Total"/>
                <field name="cargo_delivery_fee"/>
                <field name="cargo_payment_method"/>
                <field name="date_order" string="Ordered"/>
            </list>
        </field>
    </record>

    <record id="action_cargo_order" model="ir.actions.act_window">
        <field name="name">Orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('cargo_status', '!=', False)]</field>
        <field name="view_id" ref="view_sale_order_cargo_list"/>
    </record>

</odoo>
