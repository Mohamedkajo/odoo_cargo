<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cargo_notification_list" model="ir.ui.view">
        <field name="name">cargo.notification.list</field>
        <field name="model">cargo.notification</field>
        <field name="arch" type="xml">
            <list string="Notifications" default_order="id desc">
                <field name="created_at"/>
                <field name="user_id"/>
                <field name="type"/>
                <field name="title"/>
                <field name="is_read"/>
            </list>
        </field>
    </record>

    <record id="view_cargo_notification_form" model="ir.ui.view">
        <field name="name">cargo.notification.form</field>
        <field name="model">cargo.notification</field>
        <field name="arch" type="xml">
            <form string="Notification">
                <sheet>
                    <group>
                        <field name="user_id"/>
                        <field name="type"/>
                        <field name="title"/>
                        <field name="body"/>
                        <field name="is_read"/>
                        <field name="created_at"/>
                        <field name="read_at"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cargo_notification" model="ir.actions.act_window">
        <field name="name">Notifications</field>
        <field name="res_model">cargo.notification</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
