# ─────────────────────────────────────────────────────────────────────────────
# Cargo Marketplace — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL Database ───────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cargo_db
POSTGRES_USER=cargo_user
POSTGRES_PASSWORD=change_me_strong_password

# ── Odoo Settings ─────────────────────────────────────────────────────────────
ODOO_ADMIN_PASSWD=change_me_admin_master_password
ODOO_HTTP_PORT=8069
ODOO_LONGPOLLING_PORT=8072
ODOO_WORKERS=4
ODOO_MAX_CRON_THREADS=2
ODOO_LOG_LEVEL=info

# ── Cargo JWT (generated automatically on first install by post_init_hook) ────
# Do NOT set this manually — the hook generates a cryptographically random
# 512-bit secret and stores it in ir.config_parameter.
# This variable is here for reference only.
# CARGO_JWT_SECRET=generated_by_odoo_hook

# ── Docker Compose overrides (if using docker-compose.yml) ───────────────────
COMPOSE_PROJECT_NAME=cargo_marketplace

# ── Email (Odoo outgoing mail) ────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASSWORD=change_me_smtp_password
SMTP_SSL=starttls

# ── Firebase Cloud Messaging (for cargo_notification module) ─────────────────
# FCM_SERVER_KEY=your_firebase_server_key_here

# ── AWS / DigitalOcean Spaces (for cargo_media module) ───────────────────────
# S3_BUCKET=cargo-media
# S3_REGION=us-east-1
# S3_ACCESS_KEY=your_access_key
# S3_SECRET_KEY=your_secret_key
# S3_ENDPOINT_URL=https://your-space.digitaloceanspaces.com

# ── Sentry error tracking ─────────────────────────────────────────────────────
# SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development   # development | staging | production
DEBUG=false
