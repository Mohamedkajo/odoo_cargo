<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── cargo.cart — List view ────────────────────────────────────────── -->
    <record id="view_cargo_cart_list" model="ir.ui.view">
        <field name="name">cargo.cart.list</field>
        <field name="model">cargo.cart</field>
        <field name="arch" type="xml">
            <list string="Shopping Carts" create="false">
                <field name="user_id"/>
                <field name="store_id"/>
                <field name="subtotal"/>
                <field name="delivery_fee"/>
                <field name="discount"/>
                <field name="total"/>
                <field name="write_date" string="Last Updated"/>
            </list>
        </field>
    </record>

    <!-- ── cargo.cart — Form view ────────────────────────────────────────── -->
    <record id="view_cargo_cart_form" model="ir.ui.view">
        <field name="name">cargo.cart.form</field>
        <field name="model">cargo.cart</field>
        <field name="arch" type="xml">
            <form string="Shopping Cart" create="false">
                <sheet>
                    <group>
                        <group string="Cart Owner">
                            <field name="user_id"    readonly="1"/>
                            <field name="store_id"   readonly="1"/>
                            <field name="store_name" readonly="1"/>
                        </group>
                        <group string="Totals">
                            <field name="subtotal"    readonly="1"/>
                            <field name="delivery_fee" readonly="1"/>
                            <field name="discount"    readonly="1"/>
                            <field name="total"       readonly="1"/>
                            <field name="coupon_code" readonly="1"/>
                        </group>
                    </group>
                    <field name="line_ids" nolabel="1">
                        <list string="Items" create="false">
                            <field name="product_id"/>
                            <field name="name"/>
                            <field name="quantity"/>
                            <field name="price"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Action ─────────────────────────────────────────────────────────── -->
    <record id="action_cargo_cart" model="ir.actions.act_window">
        <field name="name">Shopping Carts</field>
        <field name="res_model">cargo.cart</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No active carts.</p>
        </field>
    </record>

</odoo>
