<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="page_contact" name="Cargo — Contact">
    <t t-call="cargo_website.layout">

      <!-- Hero -->
      <section class="py-20" style="background:linear-gradient(135deg,rgba(124,58,237,0.05) 0%,#faf5ff 100%)">
        <div class="max-w-4xl mx-auto px-4 text-center">
          <h1 class="text-4xl md:text-5xl font-extrabold mb-4">Get in Touch</h1>
          <p class="text-gray-500 text-lg">We'd love to hear from you. Send us a message and we'll get back to you shortly.</p>
        </div>
      </section>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">

          <!-- Contact info -->
          <div>
            <h2 class="text-xl font-bold mb-6">Contact Information</h2>
            <div class="space-y-5">
              <div class="flex gap-3">
                <div class="w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0" style="background:rgba(124,58,237,0.1)">
                  <i class="fas fa-envelope" style="font-size:18px;color:rgb(var(--color-primary))"></i>
                </div>
                <div>
                  <p class="text-xs text-gray-400 font-medium">Email</p>
                  <p class="font-medium text-sm">hello@cargo.app</p>
                </div>
              </div>
              <div class="flex gap-3">
                <div class="w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0" style="background:rgba(124,58,237,0.1)">
                  <i class="fas fa-phone" style="font-size:18px;color:rgb(var(--color-primary))"></i>
                </div>
                <div>
                  <p class="text-xs text-gray-400 font-medium">Phone</p>
                  <p class="font-medium text-sm">+1 (555) 000-0000</p>
                </div>
              </div>
              <div class="flex gap-3">
                <div class="w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0" style="background:rgba(124,58,237,0.1)">
                  <i class="fas fa-map-marker-alt" style="font-size:18px;color:rgb(var(--color-primary))"></i>
                </div>
                <div>
                  <p class="text-xs text-gray-400 font-medium">Office</p>
                  <p class="font-medium text-sm">123 Commerce St, Tech City, TC 00000</p>
                </div>
              </div>
            </div>
            <div class="mt-8 p-5 rounded-xl" style="background:rgba(124,58,237,0.05);border:1px solid rgba(124,58,237,0.2)">
              <p class="font-semibold text-sm mb-1">Business Hours</p>
              <p class="text-gray-500 text-sm">Mon–Fri: 9am–6pm</p>
              <p class="text-gray-500 text-sm">Sat–Sun: 10am–4pm</p>
            </div>
          </div>

          <!-- Form / success -->
          <div class="lg:col-span-2">
            <!-- Success state -->
            <t t-if="sent">
              <div class="border rounded-2xl p-12 bg-white text-center">
                <i class="fas fa-check-circle text-green-500 mb-4" style="font-size:56px;display:block;"></i>
                <h3 class="text-xl font-bold mb-2">Message Sent!</h3>
                <p class="text-gray-500">Thank you for reaching out. We'll get back to you within 24 hours.</p>
              </div>
            </t>

            <!-- Form -->
            <t t-else="">
              <form action="/contact" method="post" class="border rounded-2xl p-8 bg-white space-y-5">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <h2 class="text-xl font-bold">Send a Message</h2>

                <!-- Error -->
                <t t-if="error">
                  <div class="bg-red-50 text-red-600 border border-red-200 rounded-lg px-4 py-3 text-sm" t-esc="error"/>
                </t>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div>
                    <label class="block text-sm font-medium mb-1.5">Name <span class="text-red-500">*</span></label>
                    <input type="text" name="name" t-att-value="form.get('name', '') if form else ''"
                           class="w-full px-4 py-2.5 rounded-lg border focus:outline-none text-sm" placeholder="Your full name" required="required"/>
                  </div>
                  <div>
                    <label class="block text-sm font-medium mb-1.5">Email <span class="text-red-500">*</span></label>
                    <input type="email" name="email" t-att-value="form.get('email', '') if form else ''"
                           class="w-full px-4 py-2.5 rounded-lg border focus:outline-none text-sm" placeholder="you@example.com" required="required"/>
                  </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div>
                    <label class="block text-sm font-medium mb-1.5">Phone</label>
                    <input type="tel" name="phone" t-att-value="form.get('phone', '') if form else ''"
                           class="w-full px-4 py-2.5 rounded-lg border focus:outline-none text-sm" placeholder="+1 (555) 000-0000"/>
                  </div>
                  <div>
                    <label class="block text-sm font-medium mb-1.5">Subject</label>
                    <select name="subject" class="w-full px-4 py-2.5 rounded-lg border focus:outline-none text-sm bg-white">
                      <option value="general">General Inquiry</option>
                      <option value="support">Technical Support</option>
                      <option value="partnership">Partnership</option>
                      <option value="vendor">Become a Vendor</option>
                      <option value="driver">Become a Driver</option>
                      <option value="billing">Billing</option>
                      <option value="other">Other</option>
                    </select>
                  </div>
                </div>

                <div>
                  <label class="block text-sm font-medium mb-1.5">Message <span class="text-red-500">*</span></label>
                  <textarea rows="5" name="message" t-att-value="form.get('message', '') if form else ''"
                            class="w-full px-4 py-2.5 rounded-lg border focus:outline-none text-sm resize-none"
                            placeholder="Tell us about your question or request..." required="required"/>
                </div>

                <button type="submit" class="w-full text-white py-3 rounded-xl font-semibold transition-colors flex items-center justify-center gap-2" style="background-color:rgb(var(--color-primary))">
                  <i class="fas fa-paper-plane" style="font-size:14px;"></i> Send Message
                </button>
              </form>
            </t>
          </div>
        </div>
      </div>

    </t>
  </template>
</odoo>
