<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_cargo_product_list" model="ir.ui.view">
        <field name="name">cargo.product.list</field>
        <field name="model">cargo.product</field>
        <field name="arch" type="xml">
            <list string="Products">
                <field name="name"/>
                <field name="store_name"/>
                <field name="category_name"/>
                <field name="price"/>
                <field name="rating"/>
                <field name="is_available"/>
                <field name="is_featured"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_cargo_product_form" model="ir.ui.view">
        <field name="name">cargo.product.form</field>
        <field name="model">cargo.product</field>
        <field name="arch" type="xml">
            <form string="Product">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="store_id"/>
                            <field name="category_id"/>
                            <field name="is_available"/>
                            <field name="is_featured"/>
                        </group>
                        <group>
                            <field name="price"/>
                            <field name="original_price"/>
                            <field name="discount_percent"/>
                            <field name="rating"/>
                            <field name="review_count"/>
                        </group>
                    </group>
                    <group string="Flash Sale">
                        <field name="is_flash_sale"/>
                        <field name="flash_sale_price"/>
                        <field name="flash_sale_end"/>
                    </group>
                    <group string="Image">
                        <field name="image"/>
                    </group>
                    <group string="Tags">
                        <field name="tag_ids" widget="many2many_tags"/>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" nolabel="1"/>
                        </page>
                        <page string="Variants">
                            <field name="variant_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="options"/>
                                    <field name="price_delta"/>
                                </list>
                            </field>
                        </page>
                        <page string="Add-ons">
                            <field name="addon_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="price"/>
                                    <field name="is_required"/>
                                </list>
                            </field>
                        </page>
                        <page string="Gallery">
                            <field name="gallery_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="image_url"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cargo_product" model="ir.actions.act_window">
        <field name="name">Products</field>
        <field name="res_model">cargo.product</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
