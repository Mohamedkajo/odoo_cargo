# ─────────────────────────────────────────────────────────────────────────────
# Cargo Marketplace — .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Secrets and environment files ────────────────────────────────────────────
.env
.env.*
!.env.example
*.key
*.pem
*.p12
secrets/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/
pip-log.txt
pip-delete-this-directory.txt
.venv/
venv/
env/
ENV/
.python-version

# ── Odoo runtime files ────────────────────────────────────────────────────────
# Odoo stores sessions, uploads, and cached assets here
/data/
/filestore/
/sessions/

# Compiled assets generated by Odoo
/static/assets/

# Odoo .pot and .po translation files (generated, not hand-edited)
# Uncomment if you are NOT managing translations in git:
# addons/*/i18n/*.pot
# addons/*/i18n/*.po

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
*.log.*
logs/

# ── Database dumps ────────────────────────────────────────────────────────────
*.sql
*.dump
*.pgdump
*.backup
backups/

# ── Docker ────────────────────────────────────────────────────────────────────
# Keep docker-compose.yml but ignore local override files
docker-compose.override.yml
docker-compose.local.yml
.docker/

# ── IDE and editor files ──────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Coverage and test artefacts ───────────────────────────────────────────────
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/
.tox/
nosetests.xml
coverage.xml
*.cover

# ── Node.js (for Odoo JS assets) ─────────────────────────────────────────────
node_modules/
npm-debug.log
yarn-error.log
.npm/

# ── Temporary files ───────────────────────────────────────────────────────────
*.tmp
*.temp
*.bak
*.orig
*.rej
.cache/
tmp/

# ── OS files ─────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ── Replit-specific (excluded from this repo) ─────────────────────────────────
.replit
replit.nix
.upm/
.cache/
.local/
.config/replit/
