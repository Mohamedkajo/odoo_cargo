<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        cargo.wallet was removed.  The wallet balance now lives on res.users
        (cargo_wallet_balance field added by cargo_wallet module).

        Wallet transactions (cargo.wallet.transaction) are restricted by
        user_id so that each user only sees their own history.
    -->

    <record id="rule_cargo_wallet_transaction_own" model="ir.rule">
        <field name="name">Cargo Wallet Transaction: user sees own transactions only</field>
        <field name="model_id" ref="model_cargo_wallet_transaction"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('cargo_base.cargo_group_customer')),
                                    (4, ref('cargo_base.cargo_group_driver'))]"/>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>
