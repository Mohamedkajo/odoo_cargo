<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cargo_website_banner_list" model="ir.ui.view">
        <field name="name">cargo.website.banner.list</field>
        <field name="model">cargo.website.banner</field>
        <field name="arch" type="xml">
            <list string="Banners" default_order="sequence">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="title"/>
                <field name="target"/>
                <field name="valid_from"/>
                <field name="valid_until"/>
                <field name="is_active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_cargo_website_banner_form" model="ir.ui.view">
        <field name="name">cargo.website.banner.form</field>
        <field name="model">cargo.website.banner</field>
        <field name="arch" type="xml">
            <form string="Banner">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object"
                                class="oe_stat_button" icon="fa-power-off">
                            <field name="is_active" widget="boolean_button"
                                   options='{"terminology": "active"}'/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Banner internal name"/></h1>
                    </div>
                    <group>
                        <group string="Content">
                            <field name="title"/>
                            <field name="subtitle"/>
                            <field name="image_url"/>
                            <field name="cta_text"/>
                            <field name="cta_link"/>
                        </group>
                        <group string="Display">
                            <field name="sequence"/>
                            <field name="target"/>
                            <field name="valid_from"/>
                            <field name="valid_until"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cargo_website_banner" model="ir.actions.act_window">
        <field name="name">Banners</field>
        <field name="res_model">cargo.website.banner</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
