<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Main dashboard action: redirects to orders graph + live order count card -->
    <record id="action_cargo_dashboard" model="ir.actions.act_window">
        <field name="name">Cargo Dashboard</field>
        <field name="res_model">cargo.order</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="view_id" ref="cargo_reports.view_cargo_order_graph"/>
        <field name="context">{'search_default_group_status': 1}</field>
    </record>

</odoo>
