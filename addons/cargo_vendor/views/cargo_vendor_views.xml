<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cargo_vendor_list" model="ir.ui.view">
        <field name="name">cargo.vendor.list</field>
        <field name="model">cargo.vendor</field>
        <field name="arch" type="xml">
            <list string="Vendors">
                <field name="business_name"/>
                <field name="user_id"/>
                <field name="commission_rate"/>
                <field name="store_count"/>
                <field name="is_approved"/>
            </list>
        </field>
    </record>
    <record id="view_cargo_vendor_form" model="ir.ui.view">
        <field name="name">cargo.vendor.form</field>
        <field name="model">cargo.vendor</field>
        <field name="arch" type="xml">
            <form string="Vendor">
                <header>
                    <button name="action_approve" string="Approve" type="object"
                            class="oe_highlight"
                            attrs="{'invisible': [('is_approved', '=', True)]}"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="business_name"/>
                            <field name="user_id"/>
                            <field name="commission_rate"/>
                        </group>
                        <group>
                            <field name="tax_number"/>
                            <field name="bank_account"/>
                            <field name="is_approved"/>
                            <field name="approved_at"/>
                        </group>
                    </group>
                    <group string="Stores">
                        <field name="store_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_cargo_vendor" model="ir.actions.act_window">
        <field name="name">Vendors</field>
        <field name="res_model">cargo.vendor</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
